# Copy to ../.env on the VPS (same folder as docker-compose.vps.yml) and fill in.
# Generate random values with: openssl rand -hex 32   (hex keeps them URL-safe for DATABASE_URL)

PUBLIC_URL=https://portafolio.169-58-36-243.sslip.io
POSTGRES_PASSWORD=
API_KEY=
WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Optional — without them /billing and /storage docs still load, but real calls fail.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
