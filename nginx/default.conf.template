server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;
    proxy_set_header Host $host;

    location / {
        try_files $uri $uri/ =404;
    }

    location /expenses/ {
        proxy_pass http://${EXPENSES_UPSTREAM}/;
    }

    location /support/ {
        proxy_pass http://${SUPPORT_UPSTREAM}/;
    }

    location /storage/ {
        proxy_pass http://${STORAGE_UPSTREAM}/;
    }

    location /billing/ {
        proxy_pass http://${BILLING_UPSTREAM}/;
    }
}
