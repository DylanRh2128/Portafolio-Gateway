# Public demo: visitors try each API from the landing page without ever seeing a key. nginx adds
# the key server-side on a handful of fixed routes, rate-limited per IP so nobody can drain the
# OpenAI credits or fill the bucket.
limit_req_zone $binary_remote_addr zone=demo:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;
    proxy_set_header Host $host;
    # AlmacenamientoCDN accepts files up to 10 MB; nginx's 1 MB default would reject them first.
    client_max_body_size 11m;

    # Docker's DNS. Upstreams go through variables so nginx re-resolves them: otherwise it keeps
    # the IPs from startup and, once a backend is recreated, sends traffic to the wrong container.
    resolver 127.0.0.11 valid=10s;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /demo/expenses/reports {
        limit_except POST { deny all; }
        limit_req zone=demo burst=10 nodelay;
        client_max_body_size 100k;
        set $expenses ${EXPENSES_UPSTREAM};
        proxy_set_header X-API-Key ${DEMO_API_KEY};
        proxy_pass http://$expenses/reports;
    }

    location = /demo/support/classify {
        limit_except POST { deny all; }
        limit_req zone=demo burst=10 nodelay;
        client_max_body_size 20k;
        set $support ${SUPPORT_UPSTREAM};
        proxy_set_header X-Webhook-Secret ${DEMO_WEBHOOK_SECRET};
        proxy_pass http://$support/tickets/from-email;
    }

    location = /demo/storage/files {
        limit_except POST { deny all; }
        limit_req zone=demo burst=10 nodelay;
        client_max_body_size 2m;
        set $storage ${STORAGE_UPSTREAM};
        proxy_set_header X-API-Key ${DEMO_API_KEY};
        proxy_pass http://$storage/files;
    }

    location ~ ^/demo/storage/files/(\d+)/download-url$ {
        limit_except GET { deny all; }
        limit_req zone=demo burst=10 nodelay;
        set $storage ${STORAGE_UPSTREAM};
        proxy_set_header X-API-Key ${DEMO_API_KEY};
        proxy_pass http://$storage/files/$1/download-url;
    }

    location /expenses/ {
        set $expenses ${EXPENSES_UPSTREAM};
        rewrite ^/expenses/(.*)$ /$1 break;
        proxy_pass http://$expenses;
    }

    location /support/ {
        set $support ${SUPPORT_UPSTREAM};
        rewrite ^/support/(.*)$ /$1 break;
        proxy_pass http://$support;
    }

    location /storage/ {
        set $storage ${STORAGE_UPSTREAM};
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_pass http://$storage;
    }

    location /billing/ {
        set $billing ${BILLING_UPSTREAM};
        rewrite ^/billing/(.*)$ /$1 break;
        proxy_pass http://$billing;
    }
}
