server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;
    proxy_set_header Host $host;
    # AlmacenamientoCDN accepts files up to 10 MB; nginx's 1 MB default would reject them first.
    client_max_body_size 11m;

    location / {
        try_files $uri $uri/ =404;
    }

    location /expenses/ {
        proxy_pass http://${EXPENSES_UPSTREAM}/;
    }

    location /support/ {
        proxy_pass http://${SUPPORT_UPSTREAM}/;
    }

    location /storage/ {
        proxy_pass http://${STORAGE_UPSTREAM}/;
    }

    location /billing/ {
        proxy_pass http://${BILLING_UPSTREAM}/;
    }
}
